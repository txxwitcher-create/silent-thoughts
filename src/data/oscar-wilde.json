[
  {
    "id": "oscar-wilde-001",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Experience is simply the name we give our mistakes.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-002",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The only way to get rid of a temptation is to yield to it.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-003",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "There is only one thing in the world worse than being talked about, and that is not being talked about.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-004",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Nowadays people know the price of everything and the value of nothing.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-005",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "A cynic is a man who knows the price of everything and the value of nothing.",
    "source": "Attributed to Oscar Wilde; source uncertain",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-006",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The books that the world calls immoral are books that show the world its own shame.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-007",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "I can resist everything except temptation.",
    "source": "Lady Windermere's Fan",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-008",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "To love oneself is the beginning of a lifelong romance.",
    "source": "An Ideal Husband",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-009",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "We are all in the gutter, but some of us are looking at the stars.",
    "source": "Lady Windermere's Fan",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-010",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The truth is rarely pure and never simple.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-011",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Life is far too important a thing ever to talk seriously about.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-012",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The good ended happily, and the bad unhappily. That is what fiction means.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-013",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "All women become like their mothers. That is their tragedy. No man does. That is his.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-014",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "A man's face is his autobiography. A woman's face is her work of fiction.",
    "source": "Attributed to Oscar Wilde; source uncertain",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-015",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Whenever people agree with me I feel I must be wrong.",
    "source": "Attributed to Oscar Wilde; source uncertain",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-016",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Work is the curse of the drinking classes.",
    "source": "A Woman of No Importance",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-017",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The public is wonderfully tolerant. It forgives everything except genius.",
    "source": "The Critic as Artist",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-018",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Anyone who lives within their means suffers from a lack of imagination.",
    "source": "Attributed to Oscar Wilde; source uncertain",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-019",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "I have the simplest tastes. I am always satisfied with the best.",
    "source": "Attributed to Oscar Wilde; source uncertain",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-020",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The only thing to do with good advice is pass it on. It is never of any use to oneself.",
    "source": "An Ideal Husband",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-021",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The imagination imitates. The critical spirit creates.",
    "source": "The Critic as Artist",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-022",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "A little sincerity is a dangerous thing, and a great deal of it is absolutely fatal.",
    "source": "The Critic as Artist",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-023",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Art is the most intense mode of individualism that the world has known.",
    "source": "The Soul of Man Under Socialism",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-024",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "No man is rich enough to buy back his past.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-025",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Every portrait that is painted with feeling is a portrait of the artist, not of the sitter.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-026",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "There is no such thing as a moral or an immoral book. Books are well written, or badly written.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-027",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The artist is the creator of beautiful things.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-028",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Those who find ugly meanings in beautiful things are corrupt without being charming.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-029",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Beauty is a form of Genius—is higher, indeed, than Genius, as it needs no explanation.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-030",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "A thing is not necessarily true because a man dies for it.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-031",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The only difference between a caprice and a lifelong passion is that the caprice lasts a little longer.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-032",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The world is changed because you are made of ivory and gold. The curves of your lips rewrite history.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-033",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Children begin by loving their parents; as they grow older they judge them; sometimes they forgive them.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-034",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "When one is in love, one always begins by deceiving oneself, and one always ends by deceiving others.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-035",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The basis of optimism is sheer terror.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-036",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "There is no such thing as a good influence. All influence is immoral.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-037",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The only artists I have ever known who are personally delightful are bad artists.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-038",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "A great poet is the most unpoetical of all things, because he is always in the process of becoming.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-039",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Moderation is a fatal thing. Nothing succeeds like excess.",
    "source": "Attributed to Oscar Wilde; source uncertain",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-040",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The suspense is terrible. I hope it will last.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-041",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "I never travel without my diary. One should always have something sensational to read in the train.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-042",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "In matters of grave importance, style, not sincerity, is the vital thing.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-043",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The very essence of romance is uncertainty.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-044",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "It is absurd to divide people into good and bad. People are either charming or tedious.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-045",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Fashion is a form of ugliness so intolerable that we have to alter it every six months.",
    "source": "Attributed to Oscar Wilde; source uncertain",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-046",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "A gentleman is one who never hurts anyone's feelings unintentionally.",
    "source": "Attributed to Oscar Wilde; source uncertain",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-047",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The world has grown suspicious of anything that looks like a happily married life.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-048",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The truth is rarely pure, and never simple.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-049",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "I adore simple pleasures. They are the last refuge of the complex.",
    "source": "Attributed to Oscar Wilde; source uncertain",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-050",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "To get back my youth I would do anything in the world, except take exercise, get up early, or be respectable.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-051",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The only thing that consoles one for being poor is extravagance.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-052",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Society exists only as a mental concept; in the real world there are only individuals.",
    "source": "The Soul of Man Under Socialism",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-053",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Disobedience, in the eyes of anyone who has read history, is man's original virtue.",
    "source": "The Soul of Man Under Socialism",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-054",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "A map of the world that does not include Utopia is not worth even glancing at.",
    "source": "The Soul of Man Under Socialism",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-055",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The man who can dominate a London dinner-table can dominate the world.",
    "source": "Attributed to Oscar Wilde; source uncertain",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-056",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "It is through disobedience that progress has been made.",
    "source": "The Soul of Man Under Socialism",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-057",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The public has an insatiable curiosity to know everything, except what is worth knowing.",
    "source": "The Soul of Man Under Socialism",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-058",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The one duty we owe to history is to rewrite it.",
    "source": "Attributed to Oscar Wilde; source uncertain",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-059",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The old believe everything; the middle-aged suspect everything; the y
