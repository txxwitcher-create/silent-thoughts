[
  {
    "id": "oscar-wilde-001",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The truth is rarely pure and never simple.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-002",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "I can resist everything except temptation.",
    "source": "Lady Windermere's Fan",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-003",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Experience is simply the name we give our mistakes.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-004",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The only way to get rid of a temptation is to yield to it.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-005",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Nowadays people know the price of everything and the value of nothing.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-006",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "To define is to limit.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-007",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "There is only one thing in the world worse than being talked about, and that is not being talked about.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-008",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "A little sincerity is a dangerous thing, and a great deal of it is absolutely fatal.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-009",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Life is far too important a thing ever to talk seriously about.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-010",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The good ended happily, and the bad unhappily. That is what Fiction means.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-011",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Memory is the diary that we all carry about with us.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-012",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "I never travel without my diary. One should always have something sensational to read in the train.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-013",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "To lose one parent may be regarded as a misfortune; to lose both looks like carelessness.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-014",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "All women become like their mothers. That is their tragedy. No man does. That's his.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-015",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The only way to behave to a woman is to make love to her, if she is pretty, and to someone else, if she is plain.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-016",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "I don't play accurately—anyone can play accurately—but I play with wonderful expression.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-017",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Nothing that is worth knowing can be taught.",
    "source": "A Few Maxims for the Instruction of the Over-Educated",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-018",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The English are always degrading truths into facts.",
    "source": "A Few Maxims for the Instruction of the Over-Educated",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-019",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Friendship is far more tragic than love. It lasts longer.",
    "source": "A Few Maxims for the Instruction of the Over-Educated",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-020",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Art is the only serious thing in the world. And the artist is the only person who is never serious.",
    "source": "A Few Maxims for the Instruction of the Over-Educated",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-021",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "In old days books were written by men of letters and read by the public. Nowadays books are written by the public and read by nobody.",
    "source": "A Few Maxims for the Instruction of the Over-Educated",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-022",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "One should always be a little improbable.",
    "source": "Phrases and Philosophies for the Use of the Young",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-023",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "To love oneself is the beginning of a lifelong romance.",
    "source": "Phrases and Philosophies for the Use of the Young",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-024",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Ambition is the last refuge of the failure.",
    "source": "Phrases and Philosophies for the Use of the Young",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-025",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Only the shallow know themselves.",
    "source": "Phrases and Philosophies for the Use of the Young",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-026",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Patriotism is the virtue of the vicious.",
    "source": "Phrases and Philosophies for the Use of the Young",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-027",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "If one tells the truth, one is sure, sooner or later, to be found out.",
    "source": "Phrases and Philosophies for the Use of the Young",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-028",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The old believe everything; the middle-aged suspect everything; the young know everything.",
    "source": "Phrases and Philosophies for the Use of the Young",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-029",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Time is a waste of money.",
    "source": "Phrases and Philosophies for the Use of the Young",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-030",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The only thing that can console one for being poor is extravagance.",
    "source": "A Few Maxims for the Instruction of the Over-Educated",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-031",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The only thing that can console one for being rich is economy.",
    "source": "A Few Maxims for the Instruction of the Over-Educated",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-032",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Disobedience, in the eyes of anyone who has read history, is man's original virtue.",
    "source": "The Soul of Man Under Socialism",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-033",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "A map of the world that does not include Utopia is not worth even glancing at.",
    "source": "The Soul of Man Under Socialism",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-034",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The man who can dominate a London dinner-table can dominate the world.",
    "source": "The Soul of Man Under Socialism",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-035",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "It is through disobedience that progress has been made.",
    "source": "The Soul of Man Under Socialism",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-036",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The public has an insatiable curiosity to know everything, except what is worth knowing.",
    "source": "The Soul of Man Under Socialism",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-037",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "There is no such thing as a good influence. All influence is immoral.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-038",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "A man can be happy with any woman as long as he does not love her.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-039",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Behind every exquisite thing that exists, there is something tragic.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-040",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "There is no such thing as a moral or an immoral book. Books are well written, or badly written.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-041",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The books that the world calls immoral are books that show the world its own shame.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-042",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The aim of life is self-development. To realize one's nature perfectly—that is what each of us is here for.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-043",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "I choose my friends for their good looks, my acquaintances for their good characters, and my enemies for their good intellects.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-044",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Anybody can sympathize with the sufferings of a friend, but it requires a very fine nature to sympathize with a friend's success.",
    "source": "The Soul of Man Under Socialism",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-045",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "There is no sin except stupidity.",
    "source": "The Picture of Dorian Gray",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-046",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Whenever people agree with me, I always feel I must be wrong.",
    "source": "The Importance of Being Earnest",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-047",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "The world is a stage, but the play is badly cast.",
    "source": "Attributed to Wilde; source uncertain",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-048",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "We are all in the gutter, but some of us are looking at the stars.",
    "source": "Lady Windermere's Fan",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-049",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "Work is the curse of the drinking classes.",
    "source": "Attributed to Wilde; source uncertain",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  },
  {
    "id": "oscar-wilde-050",
    "entryType": "literary",
    "authorId": "oscar-wilde",
    "text": "A cynic is a man who knows the price of everything and the value of nothing.",
    "source": "Attributed wording; source/wording varies",
    "originalLanguage": "English",
    "translator": null,
    "verificationStatus": "pending_verification"
  }
]
